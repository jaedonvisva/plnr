# Copy this file to .env and fill in your real values to enable optional
# features. Without a .env file: WatIAM login stays fully manual, and
# `python agent.py` (default backend: Gemini) will fail at startup asking
# for GEMINI_API_KEY -- pass `--model qwen` instead to skip needing this
# file at all and use local Ollama/Qwen.
#
# SECURITY: .env can hold a plaintext, fully-reusable WatIAM password and a
# real, billable Gemini API key. It is gitignored -- never commit it.
# Recommended: `chmod 600 .env`.

# Optional: auto-fill the WatIAM login form (see learn/credentials.py).
# Duo is NEVER automated regardless of these being set.
WATIAM_USERNAME=your-watiam-username
WATIAM_PASSWORD=your-watiam-password

# Optional: override the local Ollama model/server used by agent.py.
# Defaults shown below -- no need to set these unless you want something else.
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# Required only if you use `--model gemini` (the default -- see agent.py's
# module docstring / agent/backend.py). Get a key at https://aistudio.google.com/apikey.
# SECURITY: this is a real, billable credential -- keep it out of git the
# same way as the WatIAM password above.
# NOTE: selecting Gemini sends your prompts and LEARN data (course names,
# grades, assignment/announcement text) to Google's API. --model qwen keeps
# everything local instead.
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the default Gemini model (same idea as OLLAMA_MODEL above).
# GEMINI_MODEL=gemini-3.1-flash-lite

# Required to run discord_bot.py: your bot's token (from
# https://discord.com/developers/applications) and YOUR Discord user ID
# (enable Developer Mode in Discord's settings, then right-click your own
# name and "Copy User ID"). Only DMs from this exact user ID are answered --
# everyone else is silently ignored. Get a key at the URL above.
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_ALLOWED_USER_ID=your-discord-user-id

# Optional: override the default persistent rate limit (5/minute, 50/hour)
# discord_adapter/ratelimit.py applies on top of TurnGuard's existing
# per-turn tool-call limits (agent/limits.py).
# DISCORD_MAX_MESSAGES_PER_MINUTE=5
# DISCORD_MAX_MESSAGES_PER_HOUR=50
