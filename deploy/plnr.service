# systemd unit for the always-on bot. Installed by deploy/deploy.sh.
[Unit]
Description=plnr LEARN agent (Discord bot + proactive monitor)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=plnr
Group=plnr
WorkingDirectory=/home/plnr/plnr
# --service: never open a browser. No saved LEARN session -> exit 75, retried below.
ExecStart=/home/plnr/plnr/.venv/bin/python discord_bot.py --service
Restart=always
RestartSec=60
Environment=PYTHONUNBUFFERED=1

# Hardening: the bot only needs to read its code and write its two state folders.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/plnr/plnr/.plnr /home/plnr/plnr/.auth
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
